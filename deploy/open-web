#!/bin/sh
# Open the existing kiosk application through a private SSH tunnel.
set -eu
jetson_target=${1:?usage: deploy/open-web SSH_TARGET}
case "$jetson_target" in -*) echo 'Invalid SSH target' >&2; exit 1;; esac
web_state="$HOME/.cache/shore-tracker"
mkdir -p "$web_state"
chmod 700 "$web_state"
web_socket="$web_state/web-18091.sock"
if ! ssh -S "$web_socket" -O check "$jetson_target" >/dev/null 2>&1; then
  ssh -M -S "$web_socket" -fNT \
    -L 127.0.0.1:18091:127.0.0.1:80 \
    -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 \
    -o ServerAliveCountMax=2 -o ConnectTimeout=5 \
    -o StrictHostKeyChecking=yes "$jetson_target"
fi
web_script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
python3 "$web_script_dir/start-recording-sync.py" --ssh "$jetson_target" || true
printf '%s\n' 'http://127.0.0.1:18091'
xdg-open 'http://127.0.0.1:18091' >/dev/null 2>&1 &
