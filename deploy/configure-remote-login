#!/bin/sh
set -eu

if [ "$(id -u)" -ne 0 ]; then
    echo "run this helper through sudo" >&2
    exit 1
fi

rdp_user=nolan
rdp_home=/var/lib/gnome-remote-desktop
certificate_dir="$rdp_home/.local/share/gnome-remote-desktop"
certificate="$certificate_dir/tls.crt"
private_key="$certificate_dir/tls.key"
tty=/dev/tty

if [ ! -c "$tty" ]; then
    echo "an interactive terminal is required" >&2
    exit 1
fi

restore_tty() {
    stty echo <"$tty" 2>/dev/null || true
}
trap restore_tty EXIT HUP INT TERM

printf 'Set a private RDP gateway password for user %s: ' "$rdp_user" >"$tty"
stty -echo <"$tty"
IFS= read -r rdp_password <"$tty"
printf '\nRepeat the RDP gateway password: ' >"$tty"
IFS= read -r rdp_password_repeat <"$tty"
stty echo <"$tty"
printf '\n' >"$tty"

if [ -z "$rdp_password" ] || [ "$rdp_password" != "$rdp_password_repeat" ]; then
    rdp_password=
    rdp_password_repeat=
    echo "RDP passwords are empty or do not match" >&2
    exit 1
fi

install -d -o gnome-remote-desktop -g gnome-remote-desktop -m 0700 \
    "$certificate_dir"
if [ ! -f "$certificate" ] || [ ! -f "$private_key" ]; then
    openssl req -newkey rsa:2048 -nodes -x509 -days 3650 \
        -subj "/CN=$(hostname)" \
        -keyout "$private_key" \
        -out "$certificate" >/dev/null 2>&1
fi
chown gnome-remote-desktop:gnome-remote-desktop "$certificate" "$private_key"
chmod 0600 "$certificate" "$private_key"

grdctl --system rdp set-tls-key "$private_key"
grdctl --system rdp set-tls-cert "$certificate"
grdctl --system rdp set-port 3389
grdctl --system rdp disable-port-negotiation
grdctl --system rdp disable-view-only
grdctl --system rdp set-credentials "$rdp_user" "$rdp_password"
rdp_password=
rdp_password_repeat=
grdctl --system rdp enable

# Ubuntu exposes gdm.service as a static alias, so it can be started but not
# enabled directly. graphical.target already owns its boot activation.
systemctl start gdm.service
systemctl enable gnome-remote-desktop.service
systemctl restart gnome-remote-desktop.service

attempt=0
while [ "$attempt" -lt 15 ]; do
    if ss -ltn | grep -qE ':[3]389[[:space:]]'; then
        rdp_address=$(nmcli -g IP4.ADDRESS device show wlP1p1s0 \
            | sed -n '1{s,/.*,,;p;}')
        echo "remote_login=ready"
        echo "rdp_address=$rdp_address"
        echo "rdp_port=3389"
        exit 0
    fi
    attempt=$((attempt + 1))
    sleep 1
done

echo "GNOME Remote Desktop did not open TCP 3389" >&2
systemctl --no-pager --full status gnome-remote-desktop.service >&2 || true
exit 1
